# --- Copyrighted books: never upload ---
# (the folder's files are ignored, except the blind-review answers file)
udc_poc/books/**
!udc_poc/books/**/
!udc_poc/books/gold/udc_gold.csv
*.pdf
desktop.ini

# --- PoC: regenerable or local-only data ---
# embedding index (~300 MB; rebuilt by `python -m udcpoc index`), reranker (retrained from feedback.db),
# catalog answers cache, metrics, backups and old runs
udc_poc/data/index/
udc_poc/data/reranker.pkl
udc_poc/data/lookup_cache.json
udc_poc/output/metrics.json
*_respaldo_*
udc_poc/_anterior_*/

# --- Tesseract models (tessdata_fast clone, ~600 MB) ---
udc_poc/data/tessdata/

# --- Python ---
.venv/
venv/
__pycache__/
*.pyc

# --- Server runtime data (database, uploaded PDFs, covers, backups) ---
biblioteca_udc/server/data/

# --- Flutter / Dart ---
# app_build/ is generated by setup_app.ps1 from app/
biblioteca_udc/app_build/
.dart_tool/
build/

